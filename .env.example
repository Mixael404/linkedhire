# ── Public (baked in at build time) ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://linkedhire.io
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Umami (заполнить после первого деплоя - взять website ID из дашборда Umami)
NEXT_PUBLIC_UMAMI_URL=http://YOUR_SERVER_IP:3001
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ── Server-side secrets (runtime only, never exposed to browser) ─────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# ── Umami (runtime - не нужны при сборке) ────────────────────────────────────
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
